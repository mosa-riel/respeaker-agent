# ESPHome secrets for the reTerminal E1001 e-paper.
# Copy to `secrets.yaml` next to reterminal-e1001.yaml (or the ESPHome add-on dir).
# NEVER commit the real file — it holds the wifi + OTA passwords.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
ota_password: "GENERATE_A_RANDOM_STRING"
