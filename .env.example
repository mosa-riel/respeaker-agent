# reSpeaker ESPHome device connection (native API, port 6053).
# Copy to .env and fill in. .env is gitignored.
RESPEAKER_HOST=respeaker-xvf3800-assistant.local
RESPEAKER_PORT=6053
# API encryption key (noise PSK). Empty if the device has no api encryption set
# (our config has none). If set, copy from ESPHome dashboard ⋮ → Show API Key.
RESPEAKER_NOISE_PSK=
# Optional legacy API password (unused if encryption key is set).
RESPEAKER_PASSWORD=

# LLM (OpenAI-compatible) API key — used by the agent's conversation loop.
LLM_API_KEY=
# STT/TTS keys are OPTIONAL — they fall back to LLM_API_KEY (same Mistral account).
# Set them only when pointing STT/TTS at a separate or local server.
STT_API_KEY=
TTS_API_KEY=